{
    "name": "streamdeck-ha-alert",
    "version": "0.2.0",
    "private": true,
    "description": "Plugin Stream Deck : alertes visuelles déclenchées par Home Assistant.",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.powange.ha-alert\"",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "validate": "streamdeck validate com.powange.ha-alert.sdPlugin",
        "pack": "npm run build && streamdeck pack com.powange.ha-alert.sdPlugin --force",
        "deploy:win": "npm run build && bash scripts/deploy-windows.sh",
        "icons": "node scripts/generate-icons.mjs"
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.10.2",
        "@elgato/utils": "^0.6.1",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@tsconfig/node24": "^24.0.5",
        "@types/node": "^24.12.0",
        "rollup": "^4.64.6",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vitest": "^5.0.4"
    },
    "dependencies": {
        "@elgato/streamdeck": "^3.0.2",
        "zod": "^4.6.7"
    }
}
